<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="OSINT Recon Suite report for {{ scan.target }} — generated {{ generated_at.strftime('%Y-%m-%d %H:%M UTC') }}" />
  <title>OSINT Report — {{ scan.target }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & tokens ──────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg-0:       #0a0d12;
      --bg-1:       #0d1117;
      --bg-2:       #161b27;
      --bg-3:       #1e2535;
      --border:     #1e2d3d;
      --border-hi:  #2a4060;
      --text-pri:   #e2e8f0;
      --text-sec:   #8899b4;
      --text-dim:   #4a5a74;
      --accent:     #39ff14;
      --accent-2:   #00d4ff;
      --green:      #39ff14;
      --yellow:     #fbbf24;
      --orange:     #ff8c00;
      --red:        #ff3e3e;
      --purple:     #a78bfa;
      --radius-sm:  6px;
      --radius-md:  10px;
      --radius-lg:  16px;
      --shadow:     0 4px 24px rgba(0,0,0,.5);
    }

    html { font-size: 16px; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg-0);
      color: var(--text-pri);
      min-height: 100vh;
      line-height: 1.6;
    }

    /* ── Layout ─────────────────────────────────────────────────── */
    .page-wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px 80px; }

    /* ── Hero header ─────────────────────────────────────────────── */
    .hero {
      position: relative;
      padding: 56px 0 40px;
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% -20%,
                  rgba(57,255,20,.08) 0%, rgba(0,212,255,.05) 50%, transparent 70%);
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: .75rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(57,255,20,.08);
      border: 1px solid rgba(57,255,20,.3);
      border-radius: 999px;
      padding: 4px 14px;
      margin-bottom: 20px;
      text-shadow: 0 0 12px rgba(57,255,20,.4);
    }

    .hero-badge::before {
      content: '';
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: .4; transform: scale(.7); }
    }

    .hero h1 {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 700;
      letter-spacing: -.02em;
      line-height: 1.15;
    }

    .hero h1 span { color: var(--accent); }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      margin-top: 20px;
      font-size: .85rem;
      color: var(--text-sec);
    }

    .hero-meta strong { color: var(--text-pri); }

    /* ── Stat cards ───────────────────────────────────────────────── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin: 36px 0;
    }

    .stat-card {
      background: var(--bg-1);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 20px 22px;
      position: relative;
      overflow: hidden;
      transition: border-color .2s, transform .2s;
    }

    .stat-card:hover {
      border-color: var(--border-hi);
      transform: translateY(-2px);
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
    }

    .stat-card.accent::before { background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
    .stat-card.green::before  { background: var(--green); box-shadow: 0 0 8px rgba(57,255,20,.4); }
    .stat-card.yellow::before { background: var(--yellow); }
    .stat-card.red::before    { background: var(--red); box-shadow: 0 0 8px rgba(255,62,62,.4); }
    .stat-card.orange::before { background: var(--orange); }

    .stat-label {
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 700;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .stat-card.accent .stat-value { color: var(--accent); }
    .stat-card.green  .stat-value { color: var(--green); }
    .stat-card.yellow .stat-value { color: var(--yellow); }
    .stat-card.red    .stat-value { color: var(--red); }
    .stat-card.orange .stat-value { color: var(--orange); }

    .stat-sub {
      font-size: .75rem;
      color: var(--text-dim);
      margin-top: 4px;
    }

    /* ── Section headings ────────────────────────────────────────── */
    .section {
      margin-top: 48px;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .section-header h2 {
      font-size: 1.15rem;
      font-weight: 600;
      letter-spacing: -.01em;
    }

    .section-header .module-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      color: var(--text-sec);
      background: var(--bg-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 2px 10px;
    }

    /* ── Module status badge ─────────────────────────────────────── */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
      border-radius: 999px;
      padding: 3px 10px;
    }

    .status-badge.success { background: rgba(57,255,20,.08); color: var(--green); border: 1px solid rgba(57,255,20,.3); }
    .status-badge.failed  { background: rgba(255,62,62,.1); color: var(--red); border: 1px solid rgba(255,62,62,.3); }
    .status-badge.partial { background: rgba(255,140,0,.1); color: var(--orange); border: 1px solid rgba(255,140,0,.3); }
    .status-badge.skipped { background: rgba(74,90,116,.12); color: var(--text-dim); border: 1px solid rgba(74,90,116,.25); }

    .status-badge::before {
      content: '';
      width: 5px; height: 5px;
      border-radius: 50%;
      background: currentColor;
    }

    /* ── Module card ─────────────────────────────────────────────── */
    .module-card {
      background: var(--bg-1);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-bottom: 24px;
      transition: border-color .2s;
    }

    .module-card:hover { border-color: var(--border-hi); }

    .module-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      padding: 18px 22px;
      background: var(--bg-2);
      border-bottom: 1px solid var(--border);
    }

    .module-card-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .module-icon {
      width: 36px; height: 36px;
      border-radius: var(--radius-sm);
      background: var(--bg-3);
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem;
    }

    .module-title { font-size: 1rem; font-weight: 600; }
    .module-dur   { font-size: .75rem; color: var(--text-dim); }

    .module-card-error {
      padding: 16px 22px;
      font-family: 'JetBrains Mono', monospace;
      font-size: .8rem;
      color: var(--red);
      background: rgba(248,113,113,.06);
    }

    .module-card-empty {
      padding: 32px 22px;
      text-align: center;
      color: var(--text-dim);
      font-size: .9rem;
    }

    /* ── Findings table ──────────────────────────────────────────── */
    .findings-table {
      width: 100%;
      border-collapse: collapse;
    }

    .findings-table th {
      text-align: left;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-dim);
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-2);
    }

    .findings-table td {
      padding: 11px 16px;
      font-size: .85rem;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    .findings-table tr:last-child td { border-bottom: none; }

    .findings-table tr:hover td { background: rgba(255,255,255,.02); }

    .findings-table td.value {
      font-family: 'JetBrains Mono', monospace;
      font-size: .78rem;
      word-break: break-all;
    }

    /* ── Risk chips ──────────────────────────────────────────────── */
    .risk {
      display: inline-block;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase;
      border-radius: 999px;
      padding: 2px 9px;
    }

    .risk.info   { background: rgba(0,212,255,.08); color: var(--accent-2); border: 1px solid rgba(0,212,255,.25); }
    .risk.low    { background: rgba(57,255,20,.08); color: var(--green); border: 1px solid rgba(57,255,20,.25); }
    .risk.medium { background: rgba(255,140,0,.1); color: var(--orange); border: 1px solid rgba(255,140,0,.3); }
    .risk.high   { background: rgba(255,62,62,.1); color: var(--red); border: 1px solid rgba(255,62,62,.3); text-shadow: 0 0 6px rgba(255,62,62,.3); }

    /* ── Extra data toggle ───────────────────────────────────────── */
    details { margin-top: 4px; }
    details summary {
      cursor: pointer;
      font-size: .72rem;
      color: var(--accent-2);
      user-select: none;
    }
    details summary:hover { text-decoration: underline; }
    details pre {
      margin-top: 6px;
      padding: 10px 12px;
      background: var(--bg-0);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-family: 'JetBrains Mono', monospace;
      font-size: .72rem;
      color: var(--text-sec);
      white-space: pre-wrap;
      word-break: break-all;
    }

    /* ── Footer ──────────────────────────────────────────────────── */
    footer {
      margin-top: 64px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
      text-align: center;
      font-size: .78rem;
      color: var(--text-dim);
    }

    footer span { color: var(--text-sec); }

    /* ── Authorization audit badge ───────────────────────────────── */
    .auth-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase;
      border-radius: 999px;
      padding: 3px 11px;
    }

    .auth-badge.interactive {
      color: var(--green);
      background: rgba(57,255,20,.08);
      border: 1px solid rgba(57,255,20,.3);
    }

    .auth-badge.bypassed {
      color: var(--orange);
      background: rgba(255,140,0,.1);
      border: 1px solid rgba(255,140,0,.3);
    }

    .auth-badge.mock {
      color: var(--accent-2);
      background: rgba(0,212,255,.08);
      border: 1px solid rgba(0,212,255,.25);
    }

    .auth-badge::before {
      content: '';
      width: 5px; height: 5px;
      border-radius: 50%;
      background: currentColor;
    }
  </style>
</head>
<body>
<div class="page-wrap">

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <header class="hero">
    <div class="hero-badge">OSINT Recon Suite</div>
    <h1>Recon Report — <span>{{ scan.target }}</span></h1>
    <div class="hero-meta">
      <div>Scan ID <strong>#{{ scan.scan_run_id }}</strong></div>
      <div>Started <strong>{{ scan.started_at.strftime('%Y-%m-%d %H:%M:%S') }} UTC</strong></div>
      {% if scan.completed_at %}
      <div>Duration <strong>{{ "%.1f"|format(scan.total_duration_s) }}s</strong></div>
      {% endif %}
      <div>Generated <strong>{{ generated_at.strftime('%Y-%m-%d %H:%M UTC') }}</strong></div>
      <div>
        Authorization
        <span class="auth-badge {{ scan.confirmation_method.value }}">
          {{ scan.confirmation_method.value }}
        </span>
      </div>
    </div>
  </header>

  <!-- ── Summary stats ─────────────────────────────────────────── -->
  <section class="stats-grid" aria-label="Summary statistics">
    <div class="stat-card accent">
      <div class="stat-label">Total Findings</div>
      <div class="stat-value">{{ scan.all_findings | length }}</div>
      <div class="stat-sub">across {{ scan.results | length }} module(s)</div>
    </div>
    <div class="stat-card red">
      <div class="stat-label">High Risk</div>
      <div class="stat-value">{{ risk_counts[RiskLevel.HIGH] }}</div>
      <div class="stat-sub">requires immediate review</div>
    </div>
    <div class="stat-card orange">
      <div class="stat-label">Medium Risk</div>
      <div class="stat-value">{{ risk_counts[RiskLevel.MEDIUM] }}</div>
      <div class="stat-sub">warrants investigation</div>
    </div>
    <div class="stat-card yellow">
      <div class="stat-label">Low Risk</div>
      <div class="stat-value">{{ risk_counts[RiskLevel.LOW] }}</div>
      <div class="stat-sub">informational</div>
    </div>
    <div class="stat-card green">
      <div class="stat-label">Info Only</div>
      <div class="stat-value">{{ risk_counts[RiskLevel.INFO] }}</div>
      <div class="stat-sub">no immediate concern</div>
    </div>
  </section>

  <!-- ── Module results ────────────────────────────────────────── -->
  <section class="section" aria-label="Module results">
    <div class="section-header">
      <h2>Module Results</h2>
    </div>

    {% for result in scan.results %}
    {% set icons = {
      'whois':     '🔍',
      'dns':       '🌐',
      'subdomain': '🗺️',
      'company':   '🏢',
      'documents': '📄',
      'metadata':  '🗂️',
      'social':    '👥'
    } %}
    <div class="module-card" id="module-{{ result.module_name }}">
      <div class="module-card-header">
        <div class="module-card-header-left">
          <div class="module-icon">{{ icons.get(result.module_name, '🔧') }}</div>
          <div>
            <div class="module-title">{{ result.module_name | title | replace('_', ' ') }}</div>
            <div class="module-dur">{{ "%.3f"|format(result.duration_s) }}s</div>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
          <span class="module-name">{{ result.module_name }}</span>
          {% if result.source_status and result.source_status != 'crtsh_ok' %}
            <span class="status-badge partial">Source: {{ result.source_status }}</span>
          {% endif %}
          <span class="status-badge {{ result.status.value }}">{{ result.status.value }}</span>
        </div>
      </div>

      {% if result.error %}
      <div class="module-card-error">
        ⚠ {{ result.error }}
      </div>
      {% elif result.findings %}
      <table class="findings-table" aria-label="{{ result.module_name }} findings">
        <thead>
          <tr>
            <th>Type</th>
            <th>Value</th>
            <th>Risk</th>
            <th>Discovered</th>
          </tr>
        </thead>
        <tbody>
          {% for finding in result.findings %}
          <tr>
            <td>{{ finding.finding_type }}</td>
            <td class="value">
              {{ finding.value }}
              {% if finding.extra and finding.extra.disclaimer %}
                <div style="margin-top: 6px; padding: 6px 10px; background: rgba(255, 140, 0, 0.1); border-left: 2px solid var(--orange); color: var(--orange); font-size: 0.72rem; font-family: 'Inter', sans-serif; white-space: normal;">
                  ⚠ {{ finding.extra.disclaimer }}
                </div>
              {% endif %}
              {% if finding.extra %}
              <details>
                <summary>extra data</summary>
                <pre>{{ finding.extra | tojson(indent=2) }}</pre>
              </details>
              {% endif %}
            </td>
            <td><span class="risk {{ finding.risk_level.value }}">{{ finding.risk_level.value }}</span></td>
            <td style="color: var(--text-sec); font-size:.78rem; white-space:nowrap;">
              {{ finding.discovered_at.strftime('%H:%M:%S') }}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="module-card-empty">
        No findings returned for this module.
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </section>

</div>

<footer>
  <p>Generated by <span>OSINT Recon Suite</span> &mdash; passive reconnaissance only &mdash; {{ generated_at.strftime('%Y-%m-%d %H:%M UTC') }}</p>
  <p style="margin-top:6px;">Only use against targets you own or have explicit written permission to test.</p>
</footer>
</body>
</html>
